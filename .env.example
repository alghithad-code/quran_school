# انسخ هذه القيم إلى متغيرات البيئة في Render (لا ترفع ملف .env إلى GitHub)
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/quran_school?retryWrites=true&w=majority
# سلسلة عشوائية طويلة (32 حرفاً فأكثر)
SESSION_SECRET=غيّرها-بسلسلة-عشوائية-طويلة
SCHOOL_TIMEZONE=Asia/Riyadh
# تُستخدم مرة واحدة فقط لإنشاء أول مدير نظام، ثم احذف كلمة المرور من Render
INITIAL_ADMIN_NAME=مدير النظام
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
